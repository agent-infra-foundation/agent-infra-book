{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "computer-local-storage-pipeline",
  "main": "./storage-worker.ts",
  "compatibility_date": "2026-05-26",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "PipelineStorage",
        "class_name": "PipelineStorage"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PipelineStorage"]
    }
  ]
}
